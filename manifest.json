{
  "manifest_version": 3,
  "name": "Lightweight Browser Agent",
  "version": "1.0.0",
  "description": "On-device visual perception based lightweight browser agent",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>",
    "file://*/*"
  ],

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Browser Agent"
  }
}